{
  "name": "spfx-chess",
  "version": "1.0.0",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-engine-assets.mjs && rspfx dev",
    "build": "rspfx build && node scripts/copy-engine-assets.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/copy-engine-assets.mjs && rspfx package",
    "deploy": "rspfx deploy",
    "analyze": "rspfx analyze",
    "doctor": "rspfx doctor",
    "playground": "rspfx playground",
    "clean": "rspfx clean",
    "engine:fetch": "node scripts/engine-assets.mjs --force",
    "check:engine": "node scripts/engine-assets.mjs --check",
    "postinstall": "node scripts/patch-rspfx-tailwind.mjs || true"
  },
  "dependencies": {
    "@mbsks/rspfx-framework-solid": "^0.0.15",
    "@microsoft/sp-component-base": "1.22.0",
    "@microsoft/sp-core-library": "1.22.0",
    "@microsoft/sp-property-pane": "1.22.0",
    "@microsoft/sp-webpart-base": "1.22.0",
    "@pnp/sp": "^4.20.0",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-table": "^8.21.3",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@mbsks/rspfx-cli": "^0.0.15",
    "@mbsks/rspfx-plugin": "^0.0.15",
    "@mbsks/rspfx-plugin-api": "^0.0.15",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@mbsks/rspfx-core": "^0.0.15",
    "@mbsks/rspfx-diagnostics": "^0.0.15",
    "@mbsks/rspfx-compiler-rspack": "^0.0.15",
    "@mbsks/rspfx-manifest-server": "^0.0.15",
    "@mbsks/rspfx-manifest-generator": "^0.0.15",
    "@mbsks/rspfx-dev-runtime": "^0.0.15",
    "@mbsks/rspfx-sharepoint-runtime": "^0.0.15",
    "@mbsks/rspfx-sppkg-builder": "^0.0.15",
    "@mbsks/rspfx-templates": "^0.0.15",
    "@mbsks/rspfx-plugin": "^0.0.15",
    "@mbsks/rspfx-plugin-api": "^0.0.15",
    "@mbsks/rspfx-framework-solid": "^0.0.15"
  }
